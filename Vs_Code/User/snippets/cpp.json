	"LL Display": {
		"prefix": "lld",
		"body": [
			"void Display(Node *head){",
			"Node* temp=head;",
			"while(temp){",
			"cout<<temp->data<<$1;",
			"temp=temp->next;",
			"}",
			"$2",
