  "Linked List Template": {
    "prefix": "llt",
    "body": [
      "#include <iostream>",
      "#include <vector>",
      "using namespace std;",
      "",
      "class Node {",
      "public:",
      "  int data;",
      "  Node* next;",
      "  Node(int value) : data(value), next(nullptr) {}",
      "  Node(int value, Node* nxt) : data(value), next(nxt) {}",
      "};",
      "",
      "Node* convertArrayToLL(vector<int> arr) {",
      "  Node* head = new Node(arr[0]);",
      "  Node* temp = head;",
      "  for (int i = 1; i < arr.size(); i++) {",
      "    Node* node = new Node(arr[i]);",
      "    temp->next = node;",
      "    temp = node;",
      "  }",
      "  return head;",
      "}",
      "",
      "void Display(Node* head) {",
      "  Node* temp = head;",
      "  while (temp) {",
      "    cout << temp->data << \" \";",
      "    temp = temp->next;",
      "  }",
      "  cout << endl;",
      "}",
      "",
      "int main() {",
      "  vector<int> arr = {2, 9, 10, 1, 29, 30, 18, 50};",
      "  Node* head = convertArrayToLL(arr);",
      "  $1",
      "  Display(head);",
      "  return 0;",
      "}"
    ],
    "description": "Linked list full template"
  },
  "LL Base Case": {
    "prefix": "llb",
    "body": [
      "if (head == nullptr || head->next == nullptr) {",
      "  return head;",
      "}",
      "Node* temp = head;"
    ],
    "description": "Linked list base case"
  },
  "Tree Template": {
    "prefix": "tc",
    "body": [
      "#include <iostream>",
      "using namespace std;",
      "",
      "class Node {",
      "public:",
      "  int data;",
      "  Node* left;",
      "  Node* right;",
      "  Node(int value) : data(value), left(nullptr), right(nullptr) {}",
      "};",
      "",
      "int main() {",
      "  Node* root = new Node(1);",
      "  root->left = new Node(2);",
      "  root->right = new Node(13);",
      "  root->left->left = new Node(9);",
      "  root->left->right = new Node(5);",
      "  $1",
      "  return 0;",
      "}"
    ],
    "description": "Binary tree template"
  },
