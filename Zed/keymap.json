// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-r": ["task::Spawn", { "task_name": "Compile and Run Java File" }]
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "ctrl-r": "projects::OpenRecent"
    }
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "ctrl-b": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-w": "pane::CloseActiveItem"
    }
  },
  {
    "bindings": {
      "ctrl-alt-shift-w": "workspace::CloseWindow"
    }
  },
  {
    "unbind": {
      "ctrl-shift-w": "workspace::CloseWindow"
    }
  },
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "bindings": {
      "ctrl-shift-w": "pane::CloseAllItems"
    }
  },
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "unbind": {
      "ctrl-w a": "pane::CloseAllItems"
    }
  },
  // Ask a Skip Alert Message:
  {
    "context": "ProjectPanel",
    "bindings": {
      "cmd-delete": ["project_panel::Delete", { "skip_prompt": true }]
    }
  },
  // Run Java/cpp File:

  {
    "context": "Editor && extension == java",
    "bindings": {
      "ctrl-alt-n": [
        "task::Spawn",
        {
          "task_name": "Compile and Run Java File"
        }
      ]
    }
  },
  {
    "context": "Editor && extension == cpp",
    "bindings": {
      "ctrl-alt-n": [
        "task::Spawn",
        {
          "task_name": "Compile and Run C++ File"
        }
      ]
    }
  },
  {
      "context": "Editor",
      "bindings": {
        "ctrl-alt-r": "editor::Redo"
      }
    },
  {
    "context": "Editor",
    "bindings": {
      "alt-shift-p": "git::ReviewDiff"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "alt-g r": "git::ReviewDiff"
    }
  },
  {
    "context": "GitPanel",
    "bindings": {
      "ctrl-g ctrl-d": "git::Diff"
    }
  },
  {
    "context": "GitPanel",
    "unbind": {
      "ctrl-g d": "git::Diff"
    }
  },
  {
    "bindings": {
      "ctrl-alt-g": "git::ViewUncommittedChanges"
    }
  },
  // For the Collapse Expan
  {
     "context": "Workspace",
     "bindings": {
       "alt-shift-x": "project_panel::CollapseAllEntries"
     }
   },
   {
     "context": "ProjectPanel && not_editing",
     "bindings": {
       "alt-shift-x": "project_panel::ExpandAllEntries"
     }
   },
   {
     "bindings": {
       "f2": "terminal::RenameTerminal"
     }
   },
   // For Rename Terminal:
   {
   "context": "ProjectPanel",
   "bindings": {
     "f2": "project_panel::Rename"
   }
   },

   {
     "context": "Editor && vim_mode == normal",
     "bindings": {
       "f2": [
         "workspace::ToggleExpandItem",
         "project_panel::Rename"
       ]
     }
   },

   // Keyword Shortcut:
    {
       "context": "Workspace",
       "bindings": {
         "ctrl-shift-e": "pane::RevealInProjectPanel"
       }
     },
     {
       "context": "ProjectPanel && not_editing",
       "bindings": {
         "ctrl-shift-e": "workspace::ToggleRightDock"
       }
     }

]
