      "\tstd::cin >> t;",
      "\twhile (t--) {",
      "\t\tint n;",
      "\t\tstd::cin >> n;",
      "\t\tstd::vector<int>vt(n);",
      "\t\tfor (int i = 0; i < n; i++) {",
      "\t\t\t\tstd::cin>>vt[i];",
      "\t\t}",
      "\t\t$1",
      "\t\tfor (int i = 0; i < n; i++) {",
      "\t\t\t\t$2",
      "\t\t}",
      "\t}",
      "\treturn 0;",
      "}"
    ]  

  }
}
